<Window
	x:Class="Ka3005P.App.Views.LicenseWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	Title="Licencja"
	Icon="/Ka3005P.App;component/Assets/KoradS.ico"
	Width="720"
	Height="560"
	MinWidth="520"
	MinHeight="360"
	ShowInTaskbar="False"
	WindowStartupLocation="CenterOwner">
	<TextBox
		x:Name="LicenseText"
		Margin="14"
		Padding="10"
		FontFamily="Consolas"
		FontSize="13"
		HorizontalScrollBarVisibility="Auto"
		IsReadOnly="True"
		TextWrapping="Wrap"
		VerticalScrollBarVisibility="Auto" />
</Window>
