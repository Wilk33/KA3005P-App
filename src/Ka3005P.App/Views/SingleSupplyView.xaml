<UserControl
	x:Class="Ka3005P.App.Views.SingleSupplyView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Ka3005P.App.Controls"
	Background="{StaticResource KoradBackgroundBrush}"
	Foreground="{StaticResource KoradTextBrush}">
	<Grid Margin="18,12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Orientation="Horizontal">
				<TextBlock Margin="0,3,6,0" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Text="Port:" />
				<ComboBox
					Width="88"
					Height="28"
					VerticalAlignment="Center"
					IsEditable="False"
					IsEnabled="{Binding CanSelectPort}"
					ItemsSource="{Binding AvailablePorts}"
					SelectedItem="{Binding SelectedPort,Mode=TwoWay}" />
			</StackPanel>
			<Button Grid.Column="1" Command="{Binding ConnectCommand}" Content="{Binding ConnectionStatus}" />
		</Grid>
		<controls:SetpointEditor Grid.Row="1" Margin="0,10,0,0" Label="Napięcie nastawy" Unit="V"
			Text="{Binding VoltageText,Mode=TwoWay}" IncrementCommand="{Binding IncrementVoltageCommand}"
			DecrementCommand="{Binding DecrementVoltageCommand}" CommitCommand="{Binding CommitVoltageCommand}" />
		<controls:SetpointEditor Grid.Row="2" Margin="0,9,0,0" Label="Ograniczenie prądu" Unit="A"
			Text="{Binding CurrentText,Mode=TwoWay}" IncrementCommand="{Binding IncrementCurrentCommand}"
			DecrementCommand="{Binding DecrementCurrentCommand}" CommitCommand="{Binding CommitCurrentCommand}" />
		<Grid Grid.Row="3" Margin="0,10,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<controls:StatusLamps IsOffline="{Binding IsOffline}" IsOff="{Binding IsOff}" IsOn="{Binding IsOn}" />
			<Button Grid.Column="1" Width="72" Command="{Binding ToggleOutputCommand}" Content="{Binding OutputButtonText}" />
		</Grid>
		<TextBlock Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right"
			Style="{StaticResource ValueTextStyle}" Text="{Binding MeasuredVoltageText}" />
		<TextBlock Grid.Row="5" HorizontalAlignment="Right"
			Style="{StaticResource ValueTextStyle}" Text="{Binding MeasuredCurrentText}" />
		<TextBlock Grid.Row="6" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="17"
			Text="{Binding ResistanceText}" />
		<TextBlock Grid.Row="7" Foreground="#FFFFA0A0" TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
	</Grid>
</UserControl>
