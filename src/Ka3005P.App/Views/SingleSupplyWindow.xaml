<Window
	x:Class="Ka3005P.App.Views.SingleSupplyWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="clr-namespace:Ka3005P.App.Controls"
	Title="Korad"
	Width="300"
	Height="455"
	MinWidth="285"
	MinHeight="430"
	WindowStartupLocation="CenterOwner">
	<DockPanel>
		<Menu DockPanel.Dock="Top">
			<MenuItem Header="Wykres" IsEnabled="False" />
			<MenuItem Header="Zapisz jako" IsEnabled="False" />
		</Menu>
		<Grid Margin="18,12">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel Orientation="Horizontal">
					<TextBlock Margin="0,8,6,0" FontSize="17" FontWeight="Bold" Text="Port:" />
					<TextBox Width="78" Text="{Binding PortName,UpdateSourceTrigger=PropertyChanged}" />
				</StackPanel>
				<Button
					Grid.Column="1"
					Command="{Binding ConnectCommand}"
					Content="{Binding ConnectionStatus}" />
			</Grid>

			<controls:SetpointEditor
				Grid.Row="1"
				Margin="0,10,0,0"
				Label="Napięcie nastawy"
				Unit="V"
				Text="{Binding VoltageText,Mode=TwoWay}"
				IncrementCommand="{Binding IncrementVoltageCommand}"
				DecrementCommand="{Binding DecrementVoltageCommand}"
				CommitCommand="{Binding CommitVoltageCommand}" />
			<controls:SetpointEditor
				Grid.Row="2"
				Margin="0,9,0,0"
				Label="Ograniczenie prądu"
				Unit="A"
				Text="{Binding CurrentText,Mode=TwoWay}"
				IncrementCommand="{Binding IncrementCurrentCommand}"
				DecrementCommand="{Binding DecrementCurrentCommand}"
				CommitCommand="{Binding CommitCurrentCommand}" />

			<Grid Grid.Row="3" Margin="0,10,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>
				<controls:StatusLamps
					IsOffline="{Binding IsOffline}"
					IsOff="{Binding IsOff}"
					IsOn="{Binding IsOn}" />
				<Button
					Grid.Column="1"
					Width="72"
					Command="{Binding ToggleOutputCommand}"
					Content="{Binding OutputButtonText}" />
			</Grid>

			<TextBlock
				Grid.Row="4"
				Margin="0,12,0,0"
				HorizontalAlignment="Right"
				Style="{StaticResource ValueTextStyle}"
				Text="{Binding MeasuredVoltageText}" />
			<TextBlock
				Grid.Row="5"
				HorizontalAlignment="Right"
				Style="{StaticResource ValueTextStyle}"
				Text="{Binding MeasuredCurrentText}" />
			<TextBlock
				Grid.Row="6"
				HorizontalAlignment="Right"
				FontFamily="Consolas"
				FontSize="17"
				Text="{Binding ResistanceText}" />
			<TextBlock
				Grid.Row="7"
				Foreground="#FFFFA0A0"
				TextWrapping="Wrap"
				Text="{Binding ErrorMessage}" />
		</Grid>
	</DockPanel>
</Window>
