<UserControl
	x:Class="Ka3005P.App.Controls.StatusLamps"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Root">
	<StackPanel Orientation="Horizontal">
		<Ellipse Width="20" Height="20" Margin="3" Fill="{StaticResource KoradOfflineBrush}">
			<Ellipse.Style>
				<Style TargetType="Ellipse">
					<Setter Property="Opacity" Value="0.28" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsOffline,ElementName=Root}" Value="True">
							<Setter Property="Opacity" Value="1" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Ellipse.Style>
		</Ellipse>
		<Ellipse Width="20" Height="20" Margin="3" Fill="{StaticResource KoradOffBrush}">
			<Ellipse.Style>
				<Style TargetType="Ellipse">
					<Setter Property="Opacity" Value="0.28" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsOff,ElementName=Root}" Value="True">
							<Setter Property="Opacity" Value="1" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Ellipse.Style>
		</Ellipse>
		<Ellipse Width="20" Height="20" Margin="3" Fill="{StaticResource KoradOnActiveBrush}">
			<Ellipse.Style>
				<Style TargetType="Ellipse">
					<Setter Property="Opacity" Value="0.28" />
					<Style.Triggers>
						<DataTrigger Binding="{Binding IsOn,ElementName=Root}" Value="True">
							<Setter Property="Opacity" Value="1" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Ellipse.Style>
		</Ellipse>
	</StackPanel>
</UserControl>
