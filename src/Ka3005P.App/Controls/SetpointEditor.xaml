<UserControl
	x:Class="Ka3005P.App.Controls.SetpointEditor"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	x:Name="Root"
	Focusable="True">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="34" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock
			Grid.ColumnSpan="2"
			Margin="0,0,0,3"
			FontSize="11"
			Text="{Binding Label,ElementName=Root}" />
		<DockPanel Grid.Row="1">
			<TextBlock
				DockPanel.Dock="Right"
				Margin="4,0"
				VerticalAlignment="Center"
				FontFamily="Consolas"
				FontSize="22"
				Text="{Binding Unit,ElementName=Root}" />
			<TextBox
				HorizontalContentAlignment="Right"
				PreviewKeyDown="TextBoxPreviewKeyDown"
				Text="{Binding Text,ElementName=Root,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" />
		</DockPanel>
		<Grid Grid.Row="1" Grid.Column="1">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<RepeatButton
				Grid.Row="0"
				Margin="2,0,0,1"
				Padding="0"
				MinHeight="0"
				Delay="350"
				Interval="60"
				Command="{Binding IncrementCommand,ElementName=Root}"
				Content="▲" />
			<RepeatButton
				Grid.Row="1"
				Margin="2,1,0,0"
				Padding="0"
				MinHeight="0"
				Delay="350"
				Interval="60"
				Command="{Binding DecrementCommand,ElementName=Root}"
				Content="▼" />
		</Grid>
	</Grid>
</UserControl>
