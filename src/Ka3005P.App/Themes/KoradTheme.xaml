<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Color x:Key="KoradBackground">#686868</Color>
	<Color x:Key="KoradInput">#858585</Color>
	<Color x:Key="KoradText">#FFFFFF</Color>
	<Color x:Key="KoradOffline">#808000</Color>
	<Color x:Key="KoradOff">#800000</Color>
	<Color x:Key="KoradOn">#008000</Color>
	<Color x:Key="KoradOnActive">#00FF00</Color>
	<SolidColorBrush x:Key="KoradBackgroundBrush" Color="{StaticResource KoradBackground}" />
	<SolidColorBrush x:Key="KoradInputBrush" Color="{StaticResource KoradInput}" />
	<SolidColorBrush x:Key="KoradTextBrush" Color="{StaticResource KoradText}" />
	<SolidColorBrush x:Key="KoradOfflineBrush" Color="{StaticResource KoradOffline}" />
	<SolidColorBrush x:Key="KoradOffBrush" Color="{StaticResource KoradOff}" />
	<SolidColorBrush x:Key="KoradOnBrush" Color="{StaticResource KoradOn}" />
	<SolidColorBrush x:Key="KoradOnActiveBrush" Color="{StaticResource KoradOnActive}" />

	<Style TargetType="Window">
		<Setter Property="Background" Value="{StaticResource KoradBackgroundBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="FontFamily" Value="Tahoma" />
		<Setter Property="TextOptions.TextFormattingMode" Value="Display" />
		<Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
	</Style>

	<Style x:Key="KoradButtonBaseStyle" TargetType="ButtonBase">
		<Setter Property="Margin" Value="3" />
		<Setter Property="Padding" Value="7,2" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="Background" Value="{StaticResource KoradInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="BorderBrush" Value="#303030" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ButtonBase">
					<Border
						x:Name="OuterBorder"
						Background="#303030"
						BorderBrush="{TemplateBinding BorderBrush}"
						BorderThickness="{TemplateBinding BorderThickness}"
						Padding="1">
						<Border
							x:Name="ButtonBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="#C4C4C4"
							BorderThickness="1,1,0,0">
							<ContentPresenter
								Margin="{TemplateBinding Padding}"
								HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
								VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#949494" />
						</Trigger>
						<Trigger Property="IsPressed" Value="True">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#565656" />
							<Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#303030" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ButtonBorder" Property="Background" Value="#747474" />
							<Setter Property="Foreground" Value="#D0D0D0" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="Button" BasedOn="{StaticResource KoradButtonBaseStyle}" />

	<Style TargetType="RepeatButton" BasedOn="{StaticResource KoradButtonBaseStyle}">
		<Setter Property="Margin" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="MinHeight" Value="0" />
	</Style>

	<Style TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource KoradInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="CaretBrush" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="BorderBrush" Value="#303030" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="20" />
		<Setter Property="FontWeight" Value="SemiBold" />
	</Style>

	<Style TargetType="ComboBox">
		<Setter Property="OverridesDefaultStyle" Value="True" />
		<Setter Property="Background" Value="{StaticResource KoradInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="BorderBrush" Value="#303030" />
		<Setter Property="BorderThickness" Value="1" />
		<Setter Property="Padding" Value="4,2" />
		<Setter Property="MinHeight" Value="28" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="ComboBox">
					<Grid>
						<Border
							x:Name="ComboBorder"
							Background="{TemplateBinding Background}"
							BorderBrush="{TemplateBinding BorderBrush}"
							BorderThickness="{TemplateBinding BorderThickness}">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="22" />
								</Grid.ColumnDefinitions>
								<ContentPresenter
									Margin="{TemplateBinding Padding}"
									VerticalAlignment="Center"
									Content="{TemplateBinding SelectionBoxItem}"
									ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
								<Border Grid.Column="1" BorderBrush="#C4C4C4" BorderThickness="1,0,0,0">
									<TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Text="▼" />
								</Border>
							</Grid>
						</Border>
						<ToggleButton
							Focusable="False"
							IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}">
							<ToggleButton.Template>
								<ControlTemplate TargetType="ToggleButton">
									<Border Background="Transparent" />
								</ControlTemplate>
							</ToggleButton.Template>
						</ToggleButton>
						<Popup
							Width="{TemplateBinding ActualWidth}"
							AllowsTransparency="True"
							IsOpen="{TemplateBinding IsDropDownOpen}"
							Placement="Bottom"
							PopupAnimation="None">
							<Border Background="{StaticResource KoradInputBrush}" BorderBrush="#303030" BorderThickness="1">
								<ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
									<StackPanel IsItemsHost="True" />
								</ScrollViewer>
							</Border>
						</Popup>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="ComboBorder" Property="Background" Value="#909090" />
						</Trigger>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="ComboBorder" Property="Background" Value="#747474" />
							<Setter Property="Foreground" Value="#D0D0D0" />
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style TargetType="ComboBoxItem">
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Background" Value="{StaticResource KoradInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="Padding" Value="4,3" />
		<Style.Triggers>
			<Trigger Property="IsMouseOver" Value="True">
				<Setter Property="Background" Value="#A0A0A0" />
			</Trigger>
			<Trigger Property="IsSelected" Value="True">
				<Setter Property="Background" Value="#5B7694" />
			</Trigger>
		</Style.Triggers>
	</Style>

	<Style x:Key="ValueTextStyle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="26" />
		<Setter Property="FontWeight" Value="SemiBold" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
	</Style>
</ResourceDictionary>
