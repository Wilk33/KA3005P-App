<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Color x:Key="KoradBackground">#686868</Color>
	<Color x:Key="KoradInput">#8A8A8A</Color>
	<Color x:Key="KoradText">#FFFFFF</Color>
	<Color x:Key="KoradOffline">#808000</Color>
	<Color x:Key="KoradOff">#800000</Color>
	<Color x:Key="KoradOn">#008000</Color>
	<Color x:Key="KoradOnActive">#00FF00</Color>
	<SolidColorBrush x:Key="KoradBackgroundBrush" Color="{StaticResource KoradBackground}" />
	<SolidColorBrush x:Key="KoradInputBrush" Color="{StaticResource KoradInput}" />
	<SolidColorBrush x:Key="KoradTextBrush" Color="{StaticResource KoradText}" />
	<SolidColorBrush x:Key="KoradOfflineBrush" Color="{StaticResource KoradOffline}" />
	<SolidColorBrush x:Key="KoradOffBrush" Color="{StaticResource KoradOff}" />
	<SolidColorBrush x:Key="KoradOnBrush" Color="{StaticResource KoradOn}" />
	<SolidColorBrush x:Key="KoradOnActiveBrush" Color="{StaticResource KoradOnActive}" />

	<Style TargetType="Window">
		<Setter Property="Background" Value="{StaticResource KoradBackgroundBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="FontFamily" Value="Segoe UI" />
	</Style>

	<Style TargetType="Button">
		<Setter Property="Margin" Value="6" />
		<Setter Property="Padding" Value="10" />
		<Setter Property="MinHeight" Value="36" />
		<Setter Property="Background" Value="{StaticResource KoradInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="BorderBrush" Value="#B0B0B0" />
		<Setter Property="BorderThickness" Value="1" />
	</Style>

	<Style TargetType="TextBox">
		<Setter Property="Background" Value="{StaticResource KoradInputBrush}" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="CaretBrush" Value="{StaticResource KoradTextBrush}" />
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="20" />
	</Style>

	<Style x:Key="ValueTextStyle" TargetType="TextBlock">
		<Setter Property="FontFamily" Value="Consolas" />
		<Setter Property="FontSize" Value="26" />
		<Setter Property="Foreground" Value="{StaticResource KoradTextBrush}" />
	</Style>
</ResourceDictionary>
